<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applesauce Studios | Destiny Comics</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; background: #020205; }
        
        /* Premium bold modern typography built for comic publishers */
        body { 
            font-family: 'Arial Black', Impact, sans-serif; 
            overflow: hidden; 
            color: #fff; 
        }
        
        /* Main structural stage */
        .stage { 
            position: relative; 
            width: 100%; 
            height: 100vh; 
            overflow: hidden; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
        }
        
        /* 1. Master Illustration Layer - Subtle breathing zoom dynamic effect */
        .bg { 
            position: absolute; 
            inset: -5%; 
            width: 110%; 
            height: 110%; 
            object-fit: cover; 
            object-position: center top; 
            animation: breathe 24s ease-in-out infinite; 
            will-change: transform; 
            z-index: 1;
        }
        @keyframes breathe { 
            0%, 100% { transform: scale(1.10); } 
            50% { transform: scale(1.16); } 
        }
        
        /* 2. Visual Pop Layer: Intense neon lighting halos accentuating your comet theme */
        .comic-pop-halos {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(circle at 75% 20%, rgba(0, 255, 136, 0.18) 0%, transparent 50%),
                radial-gradient(circle at 50% 15%, rgba(255, 115, 0, 0.25) 0%, transparent 50%),
                radial-gradient(circle at 25% 80%, rgba(147, 51, 234, 0.2) 0%, transparent 60%);
            pointer-events: none;
            z-index: 2;
        }
        
        /* 3. Dramatic Vignette Overlay - Focuses the eye seamlessly to the lower text info */
        .vignette { 
            position: absolute; 
            inset: 0; 
            background: radial-gradient(circle at 50% 40%, transparent 20%, rgba(2, 2, 5, 0.85) 95%); 
            pointer-events: none; 
            z-index: 3;
        }
        
        /* 4. Professional Brand Floating Mark - Blended top left corner */
        .corner-logo {
            position: absolute;
            top: 2rem;
            left: 2rem;
            z-index: 5;
            width: clamp(140px, 12vw, 190px);
            height: auto;
            /* Drop shadow gives a comic-pop look separating it cleanly from your artwork */
            filter: drop-shadow(0 4px 15px rgba(0, 255, 136, 0.35)) drop-shadow(0 2px 4px rgba(0,0,0,0.8));
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .corner-logo:hover {
            transform: scale(1.05) rotate(-2deg);
        }
        
        /* 5. Production Book Credits Style Layout (Inquiry Hub) */
        .credits { 
            position: absolute; 
            bottom: 3.5rem; 
            left: 0; 
            right: 0; 
            z-index: 5; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            animation: fadeup 1.4s cubic-bezier(0.22, 1, 0.36, 1) both; 
        }
        @keyframes fadeup { 
            from { opacity: 0; transform: translateY(30px); } 
            to { opacity: 1; transform: translateY(0); } 
        }
        
        /* High-contrast divider stroke */
        .rule { 
            width: 3.5rem; 
            height: 3px; 
            background: linear-gradient(90deg, #00ff88, #9333ea);
            margin-bottom: 1.5rem; 
            border-radius: 2px;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }
        
        /* Bold, ultra-clear subheaders */
        .label { 
            font-size: 11px; 
            letter-spacing: 0.4em; 
            text-transform: uppercase; 
            color: rgba(255, 255, 255, 0.5); 
            margin-bottom: 0.75rem; 
            font-weight: 900; 
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }
        
        /* Primary actionable business element */
        .email { 
            font-size: 1.15rem; 
            color: #ffffff; 
            text-decoration: none; 
            transition: all 0.3s ease; 
            font-weight: 900; 
            letter-spacing: 0.05em; 
            padding: 0.6rem 1.5rem;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 30px;
            background: rgba(2, 2, 5, 0.6);
            backdrop-filter: blur(8px); /* Modern blur effect behind the inquiry button */
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }
        
        /* Interactive feedback when submissions reviewers hover over it */
        .email:hover { 
            color: #00ff88; 
            border-color: #00ff88;
            box-shadow: 0 0 25px rgba(0, 255, 136, 0.4);
            transform: translateY(-2px);
        }
        
        @media (min-width: 768px) { 
            .email { font-size: 1.35rem; padding: 0.75rem 2rem; } 
            .label { font-size: 12px; }
            .rule { width: 4.5rem; }
        }
    </style>
</head>
<body>
    <div class="stage">
        <!-- Floating brand mark overlay -->
        <img class="corner-logo" src="logo.png" alt="Applesauce Studios Logo">
        
        <!-- Background illustrations & Visual effects stack -->
        <img class="bg" src="background.png" alt="Destiny Comics Artwork Backdrop">
        <div class="comic-pop-halos"></div>
        <div class="vignette"></div>
        
        <!-- Primary Contact Submission Asset Block -->
        <div class="credits">
            <div class="rule"></div>
            <div class="label">Distribution & Submissions</div>
            <a class="email" href="mailto:applesaucestudios1004@gmail.com">applesaucestudios1004@gmail.com</a>
        </div>
    </div>
</body>
</html>
