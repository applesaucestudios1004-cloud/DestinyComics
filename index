<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applesauce Studios</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; background: #020205; color: #fff; }
        body { font-family: Georgia, 'Times New Roman', serif; overflow-x: hidden; }

        .stage { 
            position: relative; 
            width: 100%; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column;
            align-items: center; 
            justify-content: space-between;
            padding: 3rem 1.5rem;
        }
        
        /* 1. Starry Space Background Illustration Layer */
        .bg-space { 
            position: absolute; 
            inset: -5%; 
            width: 110%; 
            height: 110%; 
            object-fit: cover; 
            object-position: center top; 
            animation: breathe 24s ease-in-out infinite; 
            will-change: transform; 
            z-index: 1;
        }
        @keyframes breathe { 
            0%, 100% { transform: scale(1.10); } 
            50% { transform: scale(1.14); } 
        }
        
        .vignette { 
            position: absolute; 
            inset: 0; 
            background: radial-gradient(circle at 50% 50%, transparent 10%, rgba(2, 2, 5, 0.92) 95%); 
            pointer-events: none; 
            z-index: 2; 
        }
        
        /* 2. Floating Top Corner Brand Icon */
        .corner-logo { 
            position: absolute; 
            top: 2rem; 
            left: 2rem; 
            z-index: 5; 
            width: clamp(110px, 9vw, 150px); 
            height: auto; 
        }
        
        /* 3. Main Center Brand Heading */
        .center-brand {
            position: relative;
            z-index: 5;
            text-align: center;
            margin-bottom: 2rem;
            margin-top: 2rem;
        }
        .title { 
            font-size: clamp(2.2rem, 5vw, 3.8rem); 
            letter-spacing: 0.15em; 
            font-weight: 400; 
            text-shadow: 0 0 30px rgba(255,255,255,0.3); 
        }
        .subheader {
            font-family: 'Arial Black', Impact, sans-serif;
            font-size: 11px;
            letter-spacing: 0.5em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 0.75rem;
        }
        
        /* 4. MAIN CENTRAL PROMOTION SPACE: Shows your actual comic cover artwork graphic */
        .showcase-zone {
            position: relative;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2rem;
            width: 100%;
            margin-bottom: 3rem;
        }

        .books-row {
            display: flex;
            flex-direction: column;
            gap: 3rem;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

        .book-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 320px;
        }

        /* Displays your actual cover image file frame precisely */
        .actual-cover-art {
            width: 100%;
            aspect-ratio: 2 / 3;
            object-fit: cover;
            border-radius: 6px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.85);
            border: 1px solid rgba(255,255,255,0.12);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .book-card:hover .actual-cover-art {
            transform: scale(1.03);
            box-shadow: 0 25px 50px rgba(0, 255, 136, 0.2);
            border-color: rgba(0, 255, 136, 0.4);
        }

        /* Coming Soon Placeholder Book Shape */
        .cover-placeholder {
            width: 100%;
            aspect-ratio: 2 / 3;
            background: linear-gradient(135deg, #0f0f15 0%, #06060a 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px dashed rgba(255,255,255,0.08);
            border-radius: 6px;
            padding: 2rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        }
        .placeholder-icon { font-size: 2.5rem; color: rgba(255,255,255,0.1); margin-bottom: 0.5rem; }
        .placeholder-text { font-family: 'Arial Black', Impact, sans-serif; font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(255,255,255,0.25); }

        .book-label {
            font-family: 'Arial Black', Impact, sans-serif;
            font-size: 10px;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-top: 1.25rem;
            text-align: center;
        }
        .label-now { color: #00ff88; text-shadow: 0 0 10px rgba(0,255,136,0.3); }
        .label-soon { color: #9333ea; text-shadow: 0 0 10px rgba(147,51,234,0.3); }

        /* 5. Clean Central Footer Contact Button */
        .footer-hub { 
            position: relative;
            z-index: 5; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            width: 100%;
        }
        .rule { width: 3.5rem; height: 2px; background: linear-gradient(90deg, #00ff88, #9333ea); margin-bottom: 1.25rem; border-radius: 2px; }
        .email { 
            font-family: 'Arial Black', Impact, sans-serif;
            font-size: 1.05rem; 
            color: #ffffff; 
            text-decoration: none; 
            transition: all 0.3s ease; 
            font-weight: 900; 
            letter-spacing: 0.05em; 
            padding: 0.75rem 2rem; 
            border: 1px solid rgba(255,255,255,0.15); 
            border-radius: 30px; 
            background: rgba(2, 2, 5, 0.75); 
            backdrop-filter: blur(10px); 
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6); 
        }
        .email:hover { color: #00ff88; border-color: #00ff88; box-shadow: 0 0 20px rgba(0, 255, 136, 0.4); transform: translateY(-1px); }
        
        /* Desktop Grid Responsiveness Setup */
        @media (min-width: 768px) { 
            .books-row { flex-direction: row; gap: 4rem; }
            .email { font-size: 1.15rem; }
        }
    </style>
</head>
<body>

    <div class="stage">
        <!-- Floating Transparent Logo Mark -->
        <img class="corner-logo" src="logo.png" alt="Applesauce Studios Logo">
        
        <!-- Animated Backdrop Layer -->
        <img class="bg-space" src="background.png" alt="Space Art Canvas">
        <div class="vignette"></div>
        
        <!-- Center Headliner Studio Title -->
        <header class="center-brand">
            <h1 class="title">Applesauce Studios</h1>
            <div class="subheader">Comic Book Studio</div>
        </header>
        
        <!-- Showcase Section: Displays your actual physical cover file graphic -->
        <section class="showcase-zone">
            <div class="books-row">
                
                <!-- Book 1: Your Real Finished Title Cover File Graphic -->
                <div class="book-card">
                    <img class="actual-cover-art" src="destiny-cover.jpg" alt="Destiny Comic Book Title Cover Artwork">
                    <div class="book-label label-now">Destiny Graphic Novel</div>
                </div>

                <!-- Book 2: Coming Soon Title Stand-in Shape -->
                <div class="book-card">
                    <div class="cover-wrap" style="width: 100%;">
                        <div class="cover-placeholder">
                            <div class="placeholder-icon">☄️</div>
                            <div class="placeholder-text">In Production</div>
                        </div>
                    </div>
                    <div class="book-label label-soon">Destiny Comics #1 (Coming Soon)</div>
                </div>

            </div>
        </section>
        
        <!-- Business Query Portal Footer -->
        <footer class="footer-hub">
            <div class="rule"></div>
            <a class="email" href="mailto:applesaucestudios1004@gmail.com">Contact / Inquiries</a>
        </footer>
    </div>

</body>
</html>
