<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Applesauce Studios</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: #000;
    font-family: Georgia, 'Times New Roman', serif;
    overflow: hidden;
    color: #fff;
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Background art */
  .bg {
    position: absolute;
    inset: -5%;
    width: 110%;
    height: 110%;
    object-fit: cover;
    object-position: center top;
    animation: breathe 26s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes breathe {
    0%, 100% { transform: scale(1.12); }
    50%      { transform: scale(1.2); }
  }

  /* Warm comet glow from the top */
  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 45% at 50% 12%, rgba(255,127,0,0.22), transparent 70%);
    pointer-events: none;
  }

  /* Cinematic vignette */
  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 100% 100% at 50% 50%, transparent 35%, rgba(0,0,0,0.75) 100%);
    pointer-events: none;
  }

  /* Center content */
  .content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
  }
  .title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: 0.2em;
    font-weight: 400;
    text-shadow: 0 0 40px rgba(255,255,255,0.2), 0 0 80px rgba(255,140,0,0.15);
    animation: fadein 1.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes fadein {
    from { opacity: 0; letter-spacing: 0.5em; }
    to   { opacity: 1; letter-spacing: 0.2em; }
  }

  /* Credits-style email, bottom */
  .credits {
    position: absolute;
    bottom: 2.5rem;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeup 1.2s ease-out 1.3s both;
  }
  @keyframes fadeup {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .rule {
    width: 2rem;
    height: 1px;
    background: rgba(255,255,255,0.2);
    margin-bottom: 1.25rem;
  }
  .label {
    font-size: 9px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
    margin-bottom: 0.75rem;
  }
  .email {
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.3s;
  }
  .email:hover { color: #fff; }

  @media (min-width: 768px) {
    .email { font-size: 1.125rem; }
  }
</style>
</head>
<body>
  <div class="stage">
    <img class="bg" src="https://media.base44.com/images/public/6a8a8ef0d2dd2a272096d20a/b803d42d4_image.png" alt="">
    <div class="glow"></div>
    <div class="vignette"></div>

    <div class="content">
      <h1 class="title">Applesauce Studios</h1>
    </div>

    <div class="credits">
      <div class="rule"></div>
      <div class="label">Inquiries</div>
      <a class="email" href__="mailto:applesaucestudios1004@gmail.com">applesaucestudios1004@gmail.com</a>
    </div>
  </div>
</body>
</html>
